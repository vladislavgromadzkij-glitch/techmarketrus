import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15
import QtGraphicalEffects 1.15

ApplicationWindow {
    id: window
    width: 1100
    height: 750
    visible: true
    title: qstr("ElectroHybrid — Электроника (Ozon + Avito)")
    color: "#F4F6F9"

    // --- Палитра брендовых цветов ---
    readonly property color brandPrimary: Qt.rgba(59/255, 93/255, 156/255, 1.0) // rgb(59, 93, 156) #3B5D9C
    readonly property color brandPrimaryHover: Qt.rgba(49/255, 78/255, 133/255, 1.0)
    readonly property color brandAccent: "#26D07C" // Зеленый акцент для б/у / выгоды
    readonly property color bgLight: "#F4F6F9"
    readonly property color cardBg: "#FFFFFF"
    readonly property color textMain: "#1E293B"
    readonly property color textMuted: "#64748B"

    // --- Модель данных (Смесь официальных магазинов и б/у объявлений) ---
    ListModel {
        id: productsModel
        ListElement {
            title: "Apple iPhone 15 Pro Max 256GB"
            price: "124 990 ₽"
            oldPrice: "139 990 ₽"
            isNew: true
            condition: "Новый (Гарантия)"
            sellerType: "Официальный магазин"
            sellerName: "ElectroStore"
            location: "Москва, Склад Ozon"
            rating: "4.9"
            imageUrl: "https://via.placeholder.com/200/3B5D9C/FFFFFF?text=iPhone+15"
            badgeColor: "#3B5D9C"
        }
        ListElement {
            title: "Игровая приставка Sony PlayStation 5"
            price: "42 000 ₽"
            oldPrice: "55 000 ₽"
            isNew: false
            condition: "Б/У (Отличное)"
            sellerType: "Частное лицо"
            sellerName: "Алексей"
            location: "Санкт-Петербург, м. Невский пр."
            rating: "5.0 (12 отзывов)"
            imageUrl: "https://via.placeholder.com/200/26D07C/FFFFFF?text=PS5+Used"
            badgeColor: "#10B981"
        }
        ListElement {
            title: "Ноутбук ASUS ROG Strix G16 i7 / RTX 4060"
            price: "135 500 ₽"
            oldPrice: ""
            isNew: true
            condition: "Новый"
            sellerType: "Магазин"
            sellerName: "ROG Official"
            location: "Екатеринбург"
            rating: "4.8"
            imageUrl: "https://via.placeholder.com/200/3B5D9C/FFFFFF?text=ASUS+ROG"
            badgeColor: "#3B5D9C"
        }
        ListElement {
            title: "Наушники AirPods Pro 2 (USB-C)"
            price: "18 500 ₽"
            oldPrice: "24 000 ₽"
            isNew: false
            condition: "Б/У (Как новые)"
            sellerType: "Частное лицо"
            sellerName: "Мария"
            location: "Москва, м. Сокольники"
            rating: "4.7 (5 отзывов)"
            imageUrl: "https://via.placeholder.com/200/26D07C/FFFFFF?text=AirPods"
            badgeColor: "#10B981"
        }
        ListElement {
            title: "Монитор LG UltraGear 27\" 165Hz IPS"
            price: "22 990 ₽"
            oldPrice: "28 990 ₽"
            isNew: true
            condition: "Новый"
            sellerType: "Официальный магазин"
            sellerName: "DisplayHub"
            location: "Краснодар"
            rating: "4.9"
            imageUrl: "https://via.placeholder.com/200/3B5D9C/FFFFFF?text=LG+Monitor"
            badgeColor: "#3B5D9C"
        }
        ListElement {
            title: "Видеокарта RTX 3070 Founders Edition"
            price: "31 000 ₽"
            oldPrice: ""
            isNew: false
            condition: "Б/У (Хорошее)"
            sellerType: "Частное лицо"
            sellerName: "Дмитрий"
            location: "Новосибирск"
            rating: "4.6 (3 отзыва)"
            imageUrl: "https://via.placeholder.com/200/26D07C/FFFFFF?text=RTX+3070"
            badgeColor: "#10B981"
        }
    }

    ColumnLayout {
        anchors.fill: parent
        spacing: 0

        // ==========================================
        // 1. ВЕРХНЯЯ ПАНЕЛЬ (HEADER)
        // ==========================================
        Rectangle {
            Layout.fillWidth: true
            Layout.preferredHeight: 72
            color: window.brandPrimary

            RowLayout {
                anchors.fill: parent
                anchors.leftMargin: 20
                anchors.rightMargin: 20
                spacing: 15

                // Логотип
                Text {
                    text: "ELECTRO<font color='#26D07C'>HUB</font>"
                    font.pixelSize: 22
                    font.bold: true
                    color: "#FFFFFF"
                    textFormat: Text.RichText
                }

                // Кнопка Каталога
                Button {
                    id: catalogBtn
                    contentItem: Text {
                        text: "☰  Каталог"
                        color: "#FFFFFF"
                        font.pixelSize: 14
                        font.bold: true
                        horizontalAlignment: Text.AlignHCenter
                        verticalAlignment: Text.AlignVCenter
                    }
                    background: Rectangle {
                        color: catalogBtn.hovered ? window.brandPrimaryHover : Qt.rgba(255, 255, 255, 0.15)
                        radius: 8
                    }
                    padding: 10
                }

                // Строка поиска (Ozon/Avito style)
                Rectangle {
                    Layout.fillWidth: true
                    Layout.preferredHeight: 42
                    color: "#FFFFFF"
                    radius: 8

                    RowLayout {
                        anchors.fill: parent
                        anchors.leftMargin: 12
                        anchors.rightMargin: 6
                        spacing: 8

                        TextField {
                            Layout.fillWidth: true
                            placeholderText: "Искать iPhone, RTX 4070, PlayStation 5..."
                            placeholderTextColor: "#94A3B8"
                            background: null
                            font.pixelSize: 14
                            color: window.textMain
                        }

                        Button {
                            Layout.preferredWidth: 80
                            Layout.fillHeight: true
                            contentItem: Text {
                                text: "Найти"
                                color: "#FFFFFF"
                                font.bold: true
                                horizontalAlignment: Text.AlignHCenter
                                verticalAlignment: Text.AlignVCenter
                            }
                            background: Rectangle {
                                color: window.brandPrimary
                                radius: 6
                            }
                        }
                    }
                }

                // Кнопка «+ Разместить объявление» (Авито фича)
                Button {
                    id: sellBtn
                    contentItem: Text {
                        text: "+ Продать"
                        color: window.brandPrimary
                        font.pixelSize: 14
                        font.bold: true
                        horizontalAlignment: Text.AlignHCenter
                        verticalAlignment: Text.AlignVCenter
                    }
                    background: Rectangle {
                        color: sellBtn.hovered ? "#F1F5F9" : "#FFFFFF"
                        radius: 8
                    }
                    padding: 12
                }

                // Профиль и Корзина
                RowLayout {
                    spacing: 12
                    
                    ToolButton {
                        contentItem: Text { text: "♡"; color: "#FFFFFF"; font.pixelSize: 20 }
                    }
                    ToolButton {
                        contentItem: Text { text: "🛒"; color: "#FFFFFF"; font.pixelSize: 20 }
                    }
                    ToolButton {
                        contentItem: Text { text: "👤"; color: "#FFFFFF"; font.pixelSize: 20 }
                    }
                }
            }
        }

        // ==========================================
        // 2. ПАНЕЛЬ ВЫБОРА РЕЖИМА (Гибридный переключатель)
        // ==========================================
        Rectangle {
            Layout.fillWidth: true
            Layout.preferredHeight: 48
            color: "#FFFFFF"

            Rectangle {
                anchors.bottom: parent.bottom
                width: parent.width
                height: 1
                color: "#E2E8F0"
            }

            RowLayout {
                anchors.fill: parent
                anchors.leftMargin: 20
                spacing: 25

                TabBar {
                    id: modeTabBar
                    background: null

                    TabButton {
                        text: "Все предложения"
                        width: implicitWidth
                    }
                    TabButton {
                        text: "🛒 Магазины (Ozon) — Новые"
                        width: implicitWidth
                    }
                    TabButton {
                        text: "🤝 Объявления (Avito) — Б/У"
                        width: implicitWidth
                    }
                }

                Item { Layout.fillWidth: true } // Спайсер

                // Быстрый фильтр города
                RowLayout {
                    anchors.rightMargin: 20
                    spacing: 5
                    Text { text: "📍"; font.pixelSize: 14 }
                    Text {
                        text: "Москва"
                        font.pixelSize: 13
                        font.bold: true
                        color: window.brandPrimary
                    }
                }
            }
        }

        // ==========================================
        // 3. ОСНОВНОЙ КОНТЕНТ (Сетка товаров)
        // ==========================================
        ScrollView {
            Layout.fillWidth: true
            Layout.fillHeight: true
            contentWidth: availableWidth
            clip: true

            ColumnLayout {
                width: parent.width
                spacing: 20
                Layout.margins: 20

                // Баннер гибридного сервиса
                Rectangle {
                    Layout.fillWidth: true
                    Layout.preferredHeight: 80
                    radius: 12
                    gradient: Gradient {
                        GradientStop { position: 0.0; color: window.brandPrimary }
                        GradientStop { position: 1.0; color: "#2A4373" }
                    }

                    RowLayout {
                        anchors.fill: parent
                        anchors.margins: 15

                        ColumnLayout {
                            Text {
                                text: "Покупайте новое с гарантией или экономьте на Б/У!"
                                color: "#FFFFFF"
                                font.pixelSize: 16
                                font.bold: true
                            }
                            Text {
                                text: "Все устройства проходят проверку подлинности и безопасную сделку."
                                color: "#CBD5E1"
                                font.pixelSize: 12
                            }
                        }

                        Item { Layout.fillWidth: true }

                        Button {
                            text: "Узнать о Безопасной сделке"
                            contentItem: Text {
                                text: parent.text
                                color: "#FFFFFF"
                                font.bold: true
                            }
                            background: Rectangle {
                                color: Qt.rgba(255,255,255,0.2)
                                radius: 6
                                border.color: "#FFFFFF"
                                border.width: 1
                            }
                        }
                    }
                }

                // Сетка карточек (GridView)
                GridView {
                    id: gridView
                    Layout.fillWidth: true
                    Layout.preferredHeight: contentHeight
                    cellWidth: 250
                    cellHeight: 380
                    interactive: false
                    model: productsModel

                    delegate: Item {
                        width: gridView.cellWidth
                        height: gridView.cellHeight

                        // Карточка товара
                        Rectangle {
                            anchors.fill: parent
                            anchors.margins: 8
                            color: window.cardBg
                            radius: 12
                            border.color: hoverHandler.hovered ? window.brandPrimary : "#E2E8F0"
                            border.width: hoverHandler.hovered ? 2 : 1

                            HoverHandler { id: hoverHandler }

                            ColumnLayout {
                                anchors.fill: parent
                                anchors.margins: 12
                                spacing: 8

                                // Изображение товара + Плашка состояния
                                Rectangle {
                                    Layout.fillWidth: true
                                    Layout.preferredHeight: 150
                                    color: "#F8FAFC"
                                    radius: 8

                                    Image {
                                        anchors.centerIn: parent
                                        source: model.imageUrl
                                        fillMode: Image.PreserveAspectFit
                                        width: 120
                                        height: 120
                                    }

                                    // Тег: Новое / Б/У
                                    Rectangle {
                                        anchors.top: parent.top
                                        anchors.left: parent.left
                                        anchors.margins: 6
                                        height: 22
                                        width: conditionText.width + 12
                                        color: model.badgeColor
                                        radius: 4

                                        Text {
                                            id: conditionText
                                            anchors.centerIn: parent
                                            text: model.condition
                                            color: "#FFFFFF"
                                            font.pixelSize: 10
                                            font.bold: true
                                        }
                                    }
                                }

                                // Название товара
                                Text {
                                    text: model.title
                                    font.pixelSize: 13
                                    font.bold: true
                                    color: window.textMain
                                    Layout.fillWidth: true
                                    elide: Text.ElideRight
                                    maximumLineCount: 2
                                    wrapMode: Text.WordWrap
                                }

                                // Цены
                                RowLayout {
                                    spacing: 6
                                    Text {
                                        text: model.price
                                        font.pixelSize: 16
                                        font.bold: true
                                        color: window.textMain
                                    }
                                    Text {
                                        visible: model.oldPrice !== ""
                                        text: model.oldPrice
                                        font.pixelSize: 12
                                        color: window.textMuted
                                        font.strikeout: true
                                    }
                                }

                                // Продавец и рейтинг
                                RowLayout {
                                    spacing: 4
                                    Text { text: "★"; color: "#F59E0B"; font.pixelSize: 12 }
                                    Text {
                                        text: model.rating
                                        font.pixelSize: 11
                                        color: window.textMuted
                                        font.bold: true
                                    }
                                    Text { text: "•"; color: window.textMuted; font.pixelSize: 11 }
                                    Text {
                                        text: model.sellerName
                                        font.pixelSize: 11
                                        color: window.textMuted
                                        elide: Text.ElideRight
                                        Layout.fillWidth: true
                                    }
                                }

                                // Локация (Важно для Авито)
                                Text {
                                    text: "📍 " + model.location
                                    font.pixelSize: 10
                                    color: "#94A3B8"
                                    Layout.fillWidth: true
                                    elide: Text.ElideRight
                                }

                                Item { Layout.fillHeight: true } // Отступ

                                // Кнопка действия (Купить / Написать)
                                Button {
                                    Layout.fillWidth: true
                                    Layout.preferredHeight: 36
                                    
                                    contentItem: Text {
                                        text: model.isNew ? "В корзину" : "Написать продавцу"
                                        color: model.isNew ? "#FFFFFF" : window.brandPrimary
                                        font.bold: true
                                        font.pixelSize: 12
                                        horizontalAlignment: Text.AlignHCenter
                                        verticalAlignment: Text.AlignVCenter
                                    }

                                    background: Rectangle {
                                        color: model.isNew ? window.brandPrimary : "transparent"
                                        border.color: window.brandPrimary
                                        border.width: 1
                                        radius: 6
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}   